{
  "manifest_version": 3,
  "name": "Browser Recorder · 本地录屏",
  "version": "1.0.0",
  "description": "标签页 / 整个屏幕 / 摄像头录制。分片写入 IndexedDB，全程本地存储，不上传任何数据。",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "desktopCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "开始录制",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/camera/camera.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "incognito": "spanning"
}
